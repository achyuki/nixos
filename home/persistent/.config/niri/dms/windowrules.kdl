// DMS Window Rules - Managed by Dux Modular Shell
// Do not edit manually - changes may be overwritten

// @id=wr_1792586399230003639 @name=规则
window-rule {
    opacity 0.85
    default-column-width { proportion 0.85; }
    background-effect {
        blur true
    }
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=wr_1792936107939372501 @name=kitty
window-rule {
    match app-id="^kitty$"
    default-column-width { proportion 0.5; }
}

// @id=wr_1792937959797475657 @name=Quick Capture
window-rule {
    match app-id="^dev.duxlabs.shell$" title="^Quick Capture$"
    open-floating true
    open-maximized true
    default-column-width { proportion 0.99; }
}

// @id=wr_1792757846926818176 @name=looking-glass-client
window-rule {
    match app-id="^looking-glass-client$"
    opacity 1.00
}

// @id=wr_1793987929577209027 @name=org.localsend.localsend_app
window-rule {
    match app-id="^org.localsend.localsend_app$"
    open-floating true
}

// @id=wr_1794071255157191916 @name=.scrcpy-wrapped
window-rule {
    match app-id="^.scrcpy-wrapped$"
    open-floating true
    default-column-width { fixed 500; }
    default-window-height { fixed 800; }
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}
